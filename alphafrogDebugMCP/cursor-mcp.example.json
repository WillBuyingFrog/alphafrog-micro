{
  "mcpServers": {
    "alphafrog-micro-debug": {
      "command": "node",
      "args": [
        "/绝对路径/alphafrog-micro/alphafrogDebugMCP/dist/server.js"
      ],
      "env": {
        "ALPHAFROG_DEBUG_SSH_CONFIG": "/你的用户名/.ssh/config",
        "ALPHAFROG_DEBUG_SSH_HOSTS": "host-a,host-b",
        "ALPHAFROG_DEBUG_SSH_HOST_TEST": "host-a",
        "ALPHAFROG_DEBUG_SSH_HOST_PROD": "host-b",
        "ALPHAFROG_DEBUG_DEFAULT_REPO_PATH": "~/alphafrog/alphafrog-micro",
        "ALPHAFROG_PG_TEST_DSN": "postgresql://user:pass@host:5432/db",
        "ALPHAFROG_PG_PROD_DSN": "postgresql://user:pass@host:5432/db"
      }
    }
  }
}
