{
  "dataType": "ci_industry_daily",
  "label": "中信行业指数日线",
  "description": "通过 TuShare ci_daily 接口抓取中信行业指数日线行情数据。日期参数使用 YYYYMMDD 字符串格式。",
  "serviceModule": "domesticIndexFetchService",

  "taskVariants": [
    {
      "subType": 1,
      "label": "按交易日抓取全部",
      "description": "按单个交易日抓取当日全部中信行业指数日线数据",
      "requiredParams": ["trade_date"],
      "optionalParams": ["offset", "limit"],
      "paramDefs": {
        "trade_date": {
          "label": "交易日",
          "description": "目标交易日，格式 yyyyMMdd",
          "type": "string",
          "format": "yyyyMMdd",
          "default": null
        },
        "offset": {
          "label": "偏移量",
          "description": "TuShare 分页偏移量",
          "type": "number",
          "default": 0
        },
        "limit": {
          "label": "每页条数",
          "description": "TuShare 分页每页条数，默认 4000",
          "type": "number",
          "default": 4000
        }
      },
      "specialFlags": ["string_date"]
    },
    {
      "subType": 2,
      "label": "按指数代码和日期范围抓取",
      "description": "按指定的中信行业指数代码和日期范围抓取日线数据",
      "requiredParams": ["ts_code", "start_date", "end_date"],
      "optionalParams": ["offset", "limit"],
      "paramDefs": {
        "ts_code": {
          "label": "指数代码",
          "description": "中信行业指数代码，如 CI005001.WI",
          "type": "string",
          "default": null
        },
        "start_date": {
          "label": "开始日期",
          "description": "日期范围的开始日期，格式 yyyyMMdd",
          "type": "string",
          "format": "yyyyMMdd",
          "default": null
        },
        "end_date": {
          "label": "结束日期",
          "description": "日期范围的结束日期，格式 yyyyMMdd",
          "type": "string",
          "format": "yyyyMMdd",
          "default": null
        },
        "offset": {
          "label": "偏移量",
          "description": "TuShare 分页偏移量",
          "type": "number",
          "default": 0
        },
        "limit": {
          "label": "每页条数",
          "description": "TuShare 分页每页条数，默认 4000",
          "type": "number",
          "default": 4000
        }
      },
      "specialFlags": ["string_date"]
    },
    {
      "subType": 3,
      "label": "历史初始化",
      "description": "按日期范围批量抓取全部中信行业指数日线数据，适用于历史数据初始化",
      "requiredParams": [],
      "optionalParams": ["start_date", "end_date", "offset", "limit"],
      "paramDefs": {
        "start_date": {
          "label": "开始日期",
          "description": "日期范围的开始日期，格式 yyyyMMdd，不传则拉取全部",
          "type": "string",
          "format": "yyyyMMdd",
          "default": null
        },
        "end_date": {
          "label": "结束日期",
          "description": "日期范围的结束日期，格式 yyyyMMdd",
          "type": "string",
          "format": "yyyyMMdd",
          "default": null
        },
        "offset": {
          "label": "偏移量",
          "description": "TuShare 分页偏移量",
          "type": "number",
          "default": 0
        },
        "limit": {
          "label": "每页条数",
          "description": "TuShare 分页每页条数，默认 4000",
          "type": "number",
          "default": 4000
        }
      },
      "specialFlags": ["string_date", "historical_init"]
    }
  ],

