{
  "dataType": "sw_industry_daily",
  "label": "申万行业行情",
  "description": "获取申万行业指数日线行情数据，包含开盘价、收盘价、涨跌幅、成交量等。",
  "serviceModule": "domesticIndexFetchService",
  "taskVariants": [
    {
      "subType": 1,
      "label": "按交易日抓取",
      "description": "指定单个交易日（yyyyMMdd），抓取当日全部申万行业行情数据。",
      "requiredParams": [
        "trade_date"
      ],
      "optionalParams": [
        "offset",
        "limit"
      ],
      "paramDefs": {
        "trade_date": {
          "label": "交易日期",
          "description": "交易日期，格式yyyyMMdd",
          "type": "string",
          "format": "yyyyMMdd",
          "default": null
        },
        "offset": {
          "label": "偏移量",
          "description": "分页偏移量，从0开始",
          "type": "number",
          "default": 0
        },
        "limit": {
          "label": "每页条数",
          "description": "单次返回最大记录数",
          "type": "number",
          "default": 5000
        }
      },
      "specialFlags": [
        "string_date"
      ]
    },
    {
      "subType": 2,
      "label": "按代码和日期范围抓取",
      "description": "指定行业代码及起止日期范围（yyyyMMdd），抓取对应行情数据。",
      "requiredParams": [
        "ts_code"
      ],
      "optionalParams": [
        "start_date",
        "end_date",
        "offset",
        "limit"
      ],
      "paramDefs": {
        "ts_code": {
          "label": "行业指数代码",
          "description": "申万行业指数代码",
          "type": "string",
          "default": null
        },
        "start_date": {
          "label": "开始日期",
          "description": "查询开始日期，格式yyyyMMdd",
          "type": "string",
          "format": "yyyyMMdd",
          "default": null
        },
        "end_date": {
          "label": "结束日期",
          "description": "查询结束日期，格式yyyyMMdd",
          "type": "string",
          "format": "yyyyMMdd",
          "default": null
        },
        "offset": {
          "label": "偏移量",
          "description": "分页偏移量，从0开始",
          "type": "number",
          "default": 0
        },
        "limit": {
          "label": "每页条数",
          "description": "单次返回最大记录数",
          "type": "number",
          "default": 5000
        }
      },
      "specialFlags": [
        "string_date"
      ]
    },
    {
      "subType": 3,
      "label": "历史初始化",
      "description": "按日期范围进行全量历史初始化抓取，不指定行业代码时抓取全部。",
      "requiredParams": [
        "start_date",
        "end_date"
      ],
      "optionalParams": [
        "offset",
        "limit"
      ],
      "paramDefs": {
        "start_date": {
          "label": "开始日期",
          "description": "历史初始化开始日期，格式yyyyMMdd",
          "type": "string",
          "format": "yyyyMMdd",
          "default": null
        },
        "end_date": {
          "label": "结束日期",
          "description": "历史初始化结束日期，格式yyyyMMdd",
          "type": "string",
          "format": "yyyyMMdd",
          "default": null
        },
        "offset": {
          "label": "偏移量",
          "description": "分页偏移量，从0开始",
          "type": "number",
          "default": 0
        },
        "limit": {
          "label": "每页条数",
          "description": "单次返回最大记录数",
          "type": "number",
          "default": 5000
        }
      },
      "specialFlags": [
        "string_date",
        "historical_init"
      ]
    }
  ],
  "taskSetVariants": [
