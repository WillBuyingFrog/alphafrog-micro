        "offset_range.end": {
          "label": "Offset 结束",
          "description": "分页结束偏移量",
          "type": "number",
          "default": null
        },
        "offset_range.step": {
          "label": "Offset 步长",
          "description": "每次步进的偏移量",
          "type": "number",
          "default": 100
