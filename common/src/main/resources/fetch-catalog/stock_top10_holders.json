          "type": "string",
          "format": "yyyyMMdd",
          "default": null
        },
        "ts_code": {
          "label": "股票代码",
          "description": "股票代码",
          "type": "string",
          "default": null
        },
        "offset": {
          "label": "偏移量",
          "description": "TuShare 分页偏移量",
          "type": "number",
          "default": 0
        },
        "limit": {
          "label": "每页条数",
          "description": "TuShare 分页每页条数",
          "type": "number",
          "default": 100
        }
