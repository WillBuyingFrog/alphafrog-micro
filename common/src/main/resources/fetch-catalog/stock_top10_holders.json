        "ts_code": {
          "label": "股票代码",
          "description": "股票代码",
          "type": "string",
          "default": null
        },
        "offset_range.start": {
          "label": "Offset 起始",
          "description": "分页起始偏移量",
          "type": "number",
          "default": 0
