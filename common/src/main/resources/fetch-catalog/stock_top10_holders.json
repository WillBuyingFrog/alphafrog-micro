      "description": "使用固定的日期范围配合 offset 步进展开",
      "expandParam": "date_range",
      "expandDescription": "使用固定的 start_date/end_date 配合 offset_range 的步进值，每个 offset 生成一条叶子任务",
      "expandStrategy": "date_range_with_offsets",
      "requiredParams": ["date_range", "offset_range"],
      "optionalParams": ["ts_code"],
      "paramDefs": {
        "date_range.start_date": {
          "label": "开始日期",
          "description": "固定的开始日期，格式 yyyyMMdd",
          "type": "string",
          "format": "yyyyMMdd",
          "default": null
