      "requiredParams": [],
      "optionalParams": ["l1_code", "l2_code", "l3_code", "ts_code", "is_new", "offset", "limit"],
      "paramDefs": {
        "l1_code": {
          "label": "一级行业代码",
          "description": "申万一级行业代码",
          "type": "string",
          "default": null
        },
        "l2_code": {
          "label": "二级行业代码",
          "description": "申万二级行业代码",
          "type": "string",
          "default": null
        },
        "l3_code": {
          "label": "三级行业代码",
